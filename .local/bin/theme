#!/usr/bin/env bash
# theme — toggle between dark and light themes across kitty, i3, polybar, vscode, firefox
# Usage: theme [light|dark|toggle|status]

set -euo pipefail

THEMES_DIR="$HOME/.config/themes"
STATE_FILE="$THEMES_DIR/current"
KBD_PREV_FILE="$THEMES_DIR/kbd_backlight_prev"
KBD_BRIGHTNESS="/sys/class/leds/tpacpi::kbd_backlight/brightness"
# Auto-detect the default-release Firefox profile. Override by exporting FF_PROFILE.
FF_PROFILE="${FF_PROFILE:-$(find "$HOME/.mozilla/firefox" -maxdepth 1 -type d -name '*.default-release' 2>/dev/null | head -1)}"

usage() {
    cat <<EOF
Usage: theme [light|dark|toggle|status]

  light    Switch to the light theme
  dark     Switch to the dark theme
  toggle   Flip to the other theme
  status   Print current theme
EOF
    exit 1
}

read_state() {
    if [[ -f "$STATE_FILE" ]]; then
        cat "$STATE_FILE"
    else
        echo dark
    fi
}

apply_kitty() {
    local mode="$1"
    ln -sf "$THEMES_DIR/kitty/$mode.conf" "$HOME/.config/kitty/theme.conf"
    if pgrep -x kitty >/dev/null 2>&1; then
        pkill -SIGUSR1 -x kitty || true
        echo "  kitty: reloaded"
    else
        echo "  kitty: not running (will apply on next launch)"
    fi
}

apply_i3() {
    local mode="$1"
    ln -sf "$THEMES_DIR/i3/$mode.conf" "$THEMES_DIR/i3/theme.conf"
    # Root window background (visible in i3 gaps / empty workspaces).
    # hsetroot is preferred because picom's xrender backend ignores the pixmap
    # set by plain `xsetroot -solid`; hsetroot sets the pixmap in a way the
    # compositor actually honors.
    local root_color
    if [[ "$mode" == "light" ]]; then
        root_color="#ffffff"
    else
        root_color="#000000"
    fi
    if command -v hsetroot >/dev/null 2>&1; then
        hsetroot -solid "$root_color" || true
    elif command -v xsetroot >/dev/null 2>&1; then
        xsetroot -solid "$root_color" || true
    fi
    if pgrep -x i3 >/dev/null 2>&1; then
        # client.* directives aren't valid runtime commands; reload reads the
        # include file and applies them.
        i3-msg -q reload || true
        echo "  i3: reloaded"
    else
        echo "  i3: not running"
    fi
}

apply_neofetch() {
    local mode="$1"
    local cfg="$HOME/.config/neofetch/config"
    [[ -f "$cfg" ]] || { echo "  neofetch: config not found, skipping"; return; }

    # ANSI color index: 0 = black, 1 = red
    local idx
    if [[ "$mode" == "light" ]]; then idx=0; else idx=1; fi

    # Swap the info color list and ascii-art color, preserving the number of entries.
    sed -i -E \
        -e "s/^colors=\\([0-9, ]+\\)/colors=($idx, $idx, $idx, $idx)/" \
        -e "s/^ascii_colors=\\([0-9, ]+\\)/ascii_colors=($idx)/" \
        "$cfg"
    echo "  neofetch: ascii/info color set to $idx"
}

apply_kbd_backlight() {
    local mode="$1"
    [[ -w "$KBD_BRIGHTNESS" ]] || { echo "  kbd backlight: not writable, skipping"; return; }

    if [[ "$mode" == "light" ]]; then
        local cur
        cur=$(cat "$KBD_BRIGHTNESS")
        if [[ "$cur" -gt 0 ]]; then
            echo "$cur" > "$KBD_PREV_FILE"
            echo 0 > "$KBD_BRIGHTNESS"
            echo "  kbd backlight: off (was $cur)"
        else
            echo "  kbd backlight: already off"
        fi
    else
        if [[ -f "$KBD_PREV_FILE" ]]; then
            local prev
            prev=$(cat "$KBD_PREV_FILE")
            echo "$prev" > "$KBD_BRIGHTNESS"
            rm -f "$KBD_PREV_FILE"
            echo "  kbd backlight: restored to $prev"
        else
            echo "  kbd backlight: no saved state, leaving as-is"
        fi
    fi
}

apply_polybar() {
    local mode="$1"
    ln -sf "$THEMES_DIR/polybar/$mode.ini" "$THEMES_DIR/polybar/theme.ini"
    if pgrep -x polybar >/dev/null 2>&1; then
        pkill -x polybar || true
        # Re-launch detached so it survives this script
        (setsid polybar >/dev/null 2>&1 &) || true
        echo "  polybar: restarted"
    else
        echo "  polybar: not running"
    fi
}

apply_vscode() {
    local mode="$1"
    local settings="$HOME/.config/Code/User/settings.json"
    [[ -f "$settings" ]] || { echo "  vscode: settings.json not found, skipping"; return; }

    local theme_name
    if [[ "$mode" == "light" ]]; then
        theme_name="Default High Contrast Light"
    else
        theme_name="Black++ Theme"
    fi

    python3 - "$settings" "$theme_name" <<'PY'
import json, sys
path, theme = sys.argv[1], sys.argv[2]
with open(path) as f:
    data = json.load(f)
data["workbench.colorTheme"] = theme
# Stop VS Code from silently overriding the theme via HC or system-scheme
# auto-detection. Without these, setting an hc-light theme triggers HC mode
# detection which falls back to preferredHighContrastColorTheme (dark).
data["window.autoDetectHighContrast"] = False
data["window.autoDetectColorScheme"] = False
# Remove any stale preferred-HC overrides that would otherwise shadow colorTheme
data.pop("workbench.preferredHighContrastColorTheme", None)
data.pop("workbench.preferredHighContrastLightColorTheme", None)
with open(path, "w") as f:
    json.dump(data, f, indent=4)
    f.write("\n")
PY
    echo "  vscode: settings.json updated (\"$theme_name\")"
}

apply_firefox() {
    local mode="$1"
    [[ -d "$FF_PROFILE" ]] || { echo "  firefox: profile not found, skipping"; return; }

    # 0 = dark, 1 = light, 2 = auto
    local value
    if [[ "$mode" == "light" ]]; then value=1; else value=0; fi

    local userjs="$FF_PROFILE/user.js"
    touch "$userjs"
    # Strip any existing entry and append the new one.
    local tmp
    tmp=$(mktemp)
    grep -v 'layout\.css\.prefers-color-scheme\.content-override' "$userjs" > "$tmp" || true
    echo "user_pref(\"layout.css.prefers-color-scheme.content-override\", $value);" >> "$tmp"
    mv "$tmp" "$userjs"

    if pgrep -x firefox >/dev/null 2>&1; then
        echo "  firefox: user.js updated — RESTART Firefox to apply"
    else
        echo "  firefox: user.js updated (will apply on next launch)"
    fi
}

set_theme() {
    local mode="$1"
    if [[ "$mode" != "dark" && "$mode" != "light" ]]; then
        echo "error: unknown theme '$mode'" >&2
        usage
    fi

    mkdir -p "$THEMES_DIR"
    echo "$mode" > "$STATE_FILE"

    echo "Switching to $mode theme..."
    apply_kitty "$mode"
    apply_i3 "$mode"
    apply_polybar "$mode"
    apply_vscode "$mode"
    apply_firefox "$mode"
    apply_neofetch "$mode"
    apply_kbd_backlight "$mode"
    echo "Done."
}

main() {
    local cmd="${1:-}"
    case "$cmd" in
        light|dark) set_theme "$cmd" ;;
        toggle)
            if [[ "$(read_state)" == "dark" ]]; then
                set_theme light
            else
                set_theme dark
            fi
            ;;
        status) read_state ;;
        *) usage ;;
    esac
}

main "$@"
